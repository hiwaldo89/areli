---
import classnames from 'classnames';

export interface Props {
    href: string;
    text: string;
    isActive: boolean;
    target?: string;
    page: string;
}

const { href, text, isActive, target, page } = Astro.props;
const hoverClass = page === 'home' ? 'hover:text-yellow' : 'hover:text-green';
---

<li
    class:list={[
        'transition ease-in-out duration-300',
        hoverClass,
        {
            'text-yellow': isActive,
        },
    ]}
>
    <a href={href} class={'uppercase'} target={target}>
        {text}
    </a>
</li>

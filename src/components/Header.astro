---
import HeaderLink from './HeaderLink.astro';
import globalData from '../data/global';

const pathname = new URL(Astro.request.url).pathname;
const { menuItems } = globalData;

const { page } = Astro.props;
const hoverClass = page === 'home' ? 'hover:text-yellow' : 'hover:text-green';
---

<nav class="max-w-7xl w-full mx-auto md:flex py-8 top-0 z-50 px-5">
    <a href="/" class={`mr-auto uppercase ${hoverClass} transition ease-in-out duration-300`}
        >areli velázquez</a
    >
    <ul class="flex items-center gap-x-10 mt-5 md:mt-0">
        {
            menuItems.map((link) => (
                <HeaderLink
                    href={link.href}
                    text={link.text}
                    isActive={pathname === link.href}
                    target={link.target}
                    page={page}
                />
            ))
        }
    </ul>
</nav>

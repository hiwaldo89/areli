---
import Layout from '../layouts/Layout.astro';
import ProjectList from '../components/ProjectList/ProjectList';
import AboutSection from '../components/AboutSection';
import projectsData from '../data/projects';

const projects = projectsData.map((project) => ({
    url: `/project/${project.slug}`,
    title: project.title,
    img: project.cover,
    category: project.categories[0],
}));
---

<Layout className="bg-green" title="Areli Velazquez | UX/UI Designer" page="home">
    <main>
        <div class="port-container mt-56">
            <div class="font-michroma text-3xl md:text-4xl lg:text-5xl xl:text-7xl">
                <p class="mb-6">Hi there!</p>
                <p class="mb-12">I’m Areli, a UX&nbsp;/&nbsp;UI&nbsp;Designer</p>
            </div>
            <p class="text-2xl mb-40 max-w-5xl">
                I work at the intersection of <strong>creative strategy, brand and digital experiences.</strong> I&nbsp;combine
                strategic thinking, creative direction and user-centered design to turn complexity into clear concepts and
                purposeful experiences.
            </p>
        </div>
        <div id="projects" class="bg-yellow">
            <ProjectList projects={projects} client:visible />
        </div>
        <AboutSection client:load />
    </main>
</Layout>

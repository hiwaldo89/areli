---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects';
import Slider from '../../components/Slider';

type ProjectImage = {
    src: string;
    alt: string;
};

interface ITwoColText {
    type: 'two-col-text';
    columns: { title: string; content: string }[];
}

interface IImage {
    type: 'image';
    src: string;
    alt: string;
}

interface ITitleAndText {
    type: 'title-and-text';
    title: string;
    text: string;
}

interface ITextAndImage {
    type: 'text-and-image';
    title: string;
    text: string;
    image: ProjectImage;
}

interface ITwoImages {
    type: 'two-images';
    leftImage: ProjectImage;
    rightImage: ProjectImage;
}

interface IText {
    type: 'text';
    content: string;
}

interface ISlider {
    type: 'slider';
    images: string[];
}

export interface Props {
    title: string;
    categories: string[];
    website: string;
    content: Array<ITwoColText | IImage | ITitleAndText | ITextAndImage | ITwoImages | IText | ISlider>;
}

export function getStaticPaths() {
    return projects.map((project) => {
        const { slug, ...props } = project;
        return {
            params: { slug },
            props,
        };
    });
}

const { title, website, content } = Astro.props;
---

<Layout title={`Areli Velazquez | ${title}`} className="bg-yellow" page="project">
    <main class="mt-16 max-w-7xl w-full mx-auto px-5">
        <a href="/" class="block hover:text-green transition ease-in-out duration-300">&lsaquo; Back to projects</a>
        <div class="md:flex items-center mt-36 mb-8">
            <h1 class="font-michroma font-medium mb-5 md:mb-0 text-3xl md:text-5xl">{title}</h1>
        </div>
        {
            !!website && (
                <a
                    href={website}
                    class="font-mono uppercase text-lg mb-20 inline-block hover:text-green transition duration-300 ease-in-out hover:border-b-yellow"
                    target="_blank"
                >
                    Visit website
                </a>
            )
        }
        {
            content.map((section) => {
                if (section.type === 'two-col-text') {
                    return (
                        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
                            {section.columns.map((column) => (
                                <div class="mb-5 md:mb-0">
                                    <h2 class="font-michroma text-4xl mb-4" set:html={column.title} />
                                    <p class="text-lg" set:html={column.content} />
                                </div>
                            ))}
                        </section>
                    );
                }

                if (section.type === 'image') {
                    return (
                        <section class="mb-24">
                            <img src={section.src} alt={section.alt} class="mx-auto max-w-full" />
                        </section>
                    );
                }

                if (section.type === 'title-and-text') {
                    return (
                        <section class="flex mb-24">
                            <div class="lg:w-4/12">
                                <h2 class="font-michroma text-4xl">{section.title}</h2>
                            </div>
                            <div class="lg:w-8/12">
                                <p class="text-lg">{section.text}</p>
                            </div>
                        </section>
                    );
                }

                if (section.type === 'text-and-image') {
                    return (
                        <section class="md:flex mb-24 items-center gap-24">
                            <div class="w-full md:w-6/12 mb-5 md:mb-0">
                                <h2 class="font-michroma text-4xl mb-4">{section.title}</h2>
                                <div class="text-lg" set:html={section.text} />
                            </div>
                            <div class="w-full md:w-6/12">
                                <img src={section.image.src} alt={section.image.alt} class="max-w-full mx-auto" />
                            </div>
                        </section>
                    );
                }

                if (section.type === 'two-images') {
                    return (
                        <section class="mb-24 flex flex-col md:flex-row gap-8 w-full">
                            <div class="md:w-6/12">
                                <img
                                    src={section.leftImage.src}
                                    alt={section.leftImage.alt}
                                    class="max-w-full mx-auto"
                                />
                            </div>
                            <div class="md:w-6/12">
                                <img
                                    src={section.rightImage.src}
                                    alt={section.rightImage.alt}
                                    class="max-w-full mx-auto"
                                />
                            </div>
                        </section>
                    );
                }

                if (section.type === 'text') {
                    return (
                        <section class="mb-24 text-section">
                            <div set:html={section.content} />
                        </section>
                    );
                }

                if (section.type === 'slider') {
                    return (
                        <section class="mb-24">
                            <Slider images={section.images} client:visible />
                        </section>
                    );
                }
            })
        }
    </main>
</Layout>

<style>
    .text-section {
        font-size: 18px;
    }

    .text-section :global(h2) {
        font-size: var(--text-4xl);
        font-family: var(--font-michroma);
    }
</style>
